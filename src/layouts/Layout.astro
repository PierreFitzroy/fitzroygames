---
import '../styles/global.css';
import logo from '../assets/logo.png';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'blog';
}

const {
  title,
  description = "Fitzroy Games crée des jeux de société pour les passionnés. Découvrez Team Spirit, notre premier jeu de course cycliste.",
  active,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="alternate" type="application/rss+xml" title="Blog Fitzroy Games" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=Lato:wght@300;400;700&family=Cinzel:wght@400;700&display=swap" rel="stylesheet" />
</head>
<body>

  <nav>
    <a href="/">
      <Image src={logo} alt="Fitzroy Games" class="nav-logo" width={50} height={50} />
    </a>
    <ul class="nav-links">
      <li><a href="/#about">A propos</a></li>
      <li><a href="/#game">Team Spirit</a></li>
      <li><a href="/blog/" aria-current={active === 'blog' ? 'page' : undefined}>Blog</a></li>
      <li><a href="/#newsletter">Newsletter</a></li>
    </ul>
    <div style="display:flex;gap:10px;align-items:center;">
      <a href="https://www.instagram.com/Fitzroy_Games" target="_blank" class="nav-ig">
        <svg style="width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.5;vertical-align:middle;" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
      </a>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer>
    <div class="footer-inner">
      <Image src={logo} alt="Fitzroy Games" class="footer-logo" width={44} height={44} />
      <p class="footer-copy">© 2025 Fitzroy Games. </p>
      <div class="footer-links">
        <a href="/#about">A propos</a>
        <a href="/#game">Jeux</a>
        <a href="/blog/">Blog</a>
        <a href="https://www.instagram.com/Fitzroy_Games" target="_blank">Instagram</a>
      </div>
    </div>
  </footer>

</body>
</html>

---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

// Récupéré sur cusdis.com après création d'un projet (Settings → App ID)
const CUSDIS_APP_ID = '02bfdd42-3e6b-4f77-bbb8-46f01e82160d';
---
<Layout title={`${post.data.title} — Blog Fitzroy Games`} description={post.data.description} active="blog">

  <header class="article-header">
    <div class="article-header-inner">
      <span class="section-label">{post.data.category}</span>
      <h1 class="article-title">{post.data.title}</h1>
      <div class="article-meta">
        <span>{dateFormatter.format(post.data.date)}</span>
      </div>
    </div>
  </header>

  <article class="article-body">
    <Content />
  </article>

  <section class="article-comments">
    <div class="comments-inner">
      <span class="section-label">Commentaires</span>
      <div
        id="cusdis_thread"
        data-host="https://cusdis.com"
        data-app-id={CUSDIS_APP_ID}
        data-page-id={post.id}
        data-page-url={Astro.url.href}
        data-page-title={post.data.title}
        data-theme="light"
      ></div>
    </div>
  </section>
  <script is:inline>
    window.CUSDIS_LOCALE = {
      powered_by: "Commentaires propulsés par Cusdis",
      post_comment: "Commenter",
      loading: "Chargement",
      email: "Email (optionnel)",
      nickname: "Pseudo",
      reply_placeholder: "Répondre...",
      reply_btn: "Répondre",
      sending: "Envoi...",
      mod_badge: "MOD",
      content_is_required: "Le commentaire ne peut pas être vide",
      nickname_is_required: "Le pseudo est requis",
      comment_has_been_sent: "Ton commentaire a bien été envoyé. Il sera visible après validation."
    };
  </script>
  <script is:inline async defer src="https://cusdis.com/js/cusdis.es.js"></script>

  <div class="article-footer-nav">
    <a href="/blog/" class="back-to-blog">← Retour au blog</a>
  </div>

</Layout>

<style>
  .article-header { background: var(--off-white); padding: 160px 5% 60px; text-align: center; }
  .article-header-inner { max-width: 760px; margin: 0 auto; }

  .article-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    color: var(--navy);
    line-height: 1.2;
    margin: 14px 0 20px;
  }

  .article-meta {
    font-family: 'Cinzel', serif;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gray);
  }

  .article-body { max-width: 720px; margin: 0 auto; padding: 64px 5% 80px; }

  .article-body :global(p) {
    font-size: 1.08rem;
    line-height: 1.9;
    color: #3a3a50;
    font-weight: 300;
    margin-bottom: 28px;
  }

  .article-body :global(h2) {
    font-family: 'Playfair Display', serif;
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--navy);
    margin: 48px 0 20px;
  }

  .article-body :global(h3) {
    font-family: 'Cinzel', serif;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    color: var(--terracotta);
    text-transform: uppercase;
    margin: 36px 0 14px;
  }

  .article-body :global(ul),
  .article-body :global(ol) { margin: 0 0 28px 22px; }

  .article-body :global(li) {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #3a3a50;
    font-weight: 300;
    margin-bottom: 10px;
  }

  .article-body :global(blockquote) {
    font-size: 1.15rem;
    font-weight: 300;
    font-style: italic;
    line-height: 1.8;
    color: var(--navy);
    border-left: 3px solid var(--gold);
    padding: 4px 0 4px 24px;
    margin: 40px 0;
  }

  .article-body :global(img) {
    width: 100%;
    height: auto;
    border-radius: 4px;
    margin: 40px 0;
  }

  .article-body :global(a) { color: var(--terracotta); }

  .article-comments { padding: 0 5% 60px; }
  .comments-inner { max-width: 720px; margin: 0 auto; }
  .comments-inner .section-label { text-align: center; }

  /* Le script Cusdis ne redimensionne pas toujours l'iframe automatiquement :
     on force une hauteur minimale généreuse pour éviter un ascenseur interne peu visible. */
  .comments-inner :global(#cusdis_thread iframe) { min-height: 600px; }

  .article-footer-nav { max-width: 720px; margin: 0 auto; padding: 0 5% 100px; text-align: center; }

  .back-to-blog {
    display: inline-block;
    font-family: 'Cinzel', serif;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--navy);
    background: transparent;
    padding: 14px 32px;
    text-decoration: none;
    border: 2px solid var(--navy);
    transition: all 0.3s;
  }
  .back-to-blog:hover { background: var(--navy); color: var(--white); }
</style>

---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFormatter = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Layout title="Blog — Fitzroy Games" description="Actualités, coulisses et carnets de développement de Fitzroy Games, éditeur de jeux de société." active="blog">

  <header class="page-header">
    <div class="page-header-inner">
      <span class="section-label">Fitzroy Games</span>
      <h1 class="page-title">Le Blog</h1>
      <p class="page-subtitle">Coulisses de développement, actualités et récits de cyclisme — les carnets de Fitzroy Games avant la sortie de Team Spirit.</p>
    </div>
  </header>

  <section class="blog-grid-section">
    {posts.length === 0 ? (
      <p class="empty-state">Aucun article pour le moment. Reviens bientôt !</p>
    ) : (
      <div class="blog-grid">
        {posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="article-card">
            <div class="article-card-image">{post.data.category}</div>
            <div class="article-card-body">
              <span class="article-card-meta">{post.data.category} · {dateFormatter.format(post.data.date)}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="article-card-link">Lire l'article →</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>

</Layout>

<style>
  .page-header {
    background: var(--navy-deep);
    padding: 160px 5% 80px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .page-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 20% 50%, rgba(201,162,39,0.07) 0%, transparent 70%),
      radial-gradient(ellipse 40% 40% at 80% 30%, rgba(196,98,45,0.06) 0%, transparent 60%);
  }

  .page-header-inner { position: relative; z-index: 1; max-width: 700px; margin: 0 auto; }

  .page-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 900;
    color: var(--white);
    line-height: 1.15;
    margin-bottom: 20px;
  }

  .page-subtitle {
    font-size: 1.05rem;
    font-weight: 300;
    color: rgba(249,246,241,0.7);
    line-height: 1.7;
  }

  .blog-grid-section { padding: 80px 5% 120px; background: var(--off-white); }

  .blog-grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 32px;
  }

  .article-card {
    background: white;
    border: 1px solid var(--gray-light);
    border-top: 3px solid var(--gold);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .article-card:hover { transform: translateY(-4px); box-shadow: 0 16px 50px rgba(30,58,95,0.12); }

  .article-card-image {
    height: 190px;
    background: linear-gradient(135deg, var(--navy), var(--navy-deep));
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(249,246,241,0.35);
    font-family: 'Cinzel', serif;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-align: center;
    padding: 16px;
  }

  .article-card-body { padding: 24px 22px 28px; display: flex; flex-direction: column; flex: 1; }

  .article-card-meta {
    font-family: 'Cinzel', serif;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--terracotta);
    margin-bottom: 10px;
  }

  .article-card h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.3;
    margin-bottom: 10px;
  }

  .article-card p { font-size: 0.92rem; color: var(--gray); line-height: 1.6; margin-bottom: 18px; flex: 1; }

  .article-card-link {
    font-family: 'Cinzel', serif;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--navy);
    transition: color 0.3s;
  }
  .article-card:hover .article-card-link { color: var(--terracotta); }

  .empty-state {
    max-width: 500px;
    margin: 0 auto;
    text-align: center;
    padding: 40px 20px;
    color: var(--gray);
    font-size: 0.95rem;
    line-height: 1.7;
  }
</style>
